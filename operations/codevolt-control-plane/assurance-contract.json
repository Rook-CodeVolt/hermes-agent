  "receipt_schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "receipt_schema_rules": {
    "all_objects_additional_properties": false,
    "duplicate_json_keys": "reject_before_validation",
    "unknown_evidence_type": "reject",
    "unknown_reason_code": "reject",
    "unknown_gate_reason_combination": "reject",
    "timestamps": "RFC3339 UTC with terminal Z",
    "arrays": "preserve declared order except arrays with x-sort-key; reject duplicates",
    "prerequisites": "each prerequisite hash binds a closed {input,output,prerequisites} envelope; recursively validate the complete chain"
  },
  "evidence_type_registry": {
    "registry_version": 1,
    "unknown_type_policy": "reject",
    "types": {
      "artifact_digest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "evidence_id", "subject", "sha256", "byte_length", "media_type", "produced_at_utc"],
        "properties": {
          "type": {"const": "artifact_digest"},
          "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "subject": {"type": "string", "minLength": 1, "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
          "produced_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      },
      "test_receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "evidence_id", "suite", "verdict", "passed", "failed", "receipt_sha256", "produced_at_utc"],
        "properties": {
          "type": {"const": "test_receipt"},
          "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "suite": {"type": "string", "minLength": 1, "maxLength": 256},
          "verdict": {"enum": ["PASS", "BLOCK"]},
          "passed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "produced_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      },
      "process_identity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "evidence_id", "profile", "pid", "birth_token", "executable_sha256", "release_id", "observed_at_utc"],
        "properties": {
          "type": {"const": "process_identity"},
          "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "profile": {"enum": ["clara", "daniel", "elias", "hannah", "maya", "oliver", "rook", "sophie"]},
          "pid": {"type": "integer", "minimum": 1},
          "birth_token": {"type": "string", "minLength": 1, "maxLength": 256},
          "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "observed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      },
      "control_observation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "evidence_id", "control_id", "sequence", "verdict", "receipt_sha256", "observed_at_utc"],
        "properties": {
          "type": {"const": "control_observation"},
          "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "control_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,127}$"},
          "sequence": {"type": "integer", "minimum": 0},
          "verdict": {"enum": ["PASS", "BLOCK"]},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "observed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      },
      "authorization": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "evidence_id", "approver", "action", "release_id", "authorization_sha256", "authorized_at_utc", "expires_at_utc"],
        "properties": {
          "type": {"const": "authorization"},
          "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "approver": {"const": "rook"},
          "action": {"enum": ["website_priority_pass", "continuity_active_pass", "live_activation", "rollback"]},
          "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authorized_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
          "expires_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      },
      "transaction_receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "evidence_id", "release_id", "preimage_sha256", "postimage_sha256", "restart_scope_sha256", "verdict", "recovery_seconds", "completed_at_utc"],
        "properties": {
          "type": {"const": "transaction_receipt"},
          "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "preimage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "postimage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "restart_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verdict": {"enum": ["PASS", "BLOCK"]},
          "recovery_seconds": {"type": "integer", "minimum": 0},
          "completed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      }
    }
  },
  "gate_input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "gate_id", "release_id", "stage", "source_commit", "source_tree", "policy_version", "manifest_sha256", "actor", "actor_role", "prerequisite_receipts", "evidence", "observed_at_utc"],
    "properties": {
      "schema_version": {"const": 1},
      "gate_id": {"enum": ["G10_SOURCE_REVIEW", "G20_SCRATCH_PROOF", "G30_EXACT_BYTE_APPROVAL", "G40_WEBSITE_PRIORITY", "G41_CONTINUITY_ACTIVE", "G50_LIVE_ACTIVATION", "G60_ACTIVE_STATE"]},
      "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
      "stage": {"enum": ["source_review", "scratch_proof", "exact_byte_approval", "live_activation", "active_state_verification"]},
      "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "policy_version": {"const": "cv-control-plane-assurance-v2"},
      "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "actor": {"enum": ["clara", "daniel", "elias", "hannah", "maya", "oliver", "rook", "sophie"]},
      "actor_role": {"enum": ["author", "operator", "exact_byte_reviewer", "active_runtime_reviewer", "approver"]},
      "prerequisite_receipts": {"type": "array", "uniqueItems": true, "x-sort-key": "lexicographic", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "x-sort-key": ["type", "evidence_id"], "items": {"oneOf": [
        {"$ref": "#/evidence_type_registry/types/artifact_digest"},
        {"$ref": "#/evidence_type_registry/types/test_receipt"},
        {"$ref": "#/evidence_type_registry/types/process_identity"},
        {"$ref": "#/evidence_type_registry/types/control_observation"},
        {"$ref": "#/evidence_type_registry/types/authorization"},
        {"$ref": "#/evidence_type_registry/types/transaction_receipt"}
      ]}},
      "observed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
    }
  },
  "gate_output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "gate_id", "release_id", "stage", "verdict", "reason_codes", "findings", "produced_evidence", "evidence_sha256", "actor", "observed_at_utc"],
    "properties": {
      "schema_version": {"const": 1},
      "gate_id": {"enum": ["G10_SOURCE_REVIEW", "G20_SCRATCH_PROOF", "G30_EXACT_BYTE_APPROVAL", "G40_WEBSITE_PRIORITY", "G41_CONTINUITY_ACTIVE", "G50_LIVE_ACTIVATION", "G60_ACTIVE_STATE"]},
      "release_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-equals-input": "release_id"},
      "stage": {"enum": ["source_review", "scratch_proof", "exact_byte_approval", "live_activation", "active_state_verification"], "x-equals-input": "stage"},
      "verdict": {"enum": ["PASS", "BLOCK"]},
      "reason_codes": {"type": "array", "uniqueItems": true, "x-sort-key": "lexicographic", "items": {"type": "string", "x-enum-source": "#/reason_code_registry/gate_output_codes"}, "x-empty-iff-verdict": "PASS"},
      "findings": {"type": "array", "x-empty-iff-verdict": "PASS", "items": {"type": "object", "additionalProperties": false, "required": ["reason_code", "summary", "evidence_ids"], "properties": {
        "reason_code": {"type": "string", "x-member-of-output": "reason_codes"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "x-sort-key": "lexicographic", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}}
      }}},
      "produced_evidence": {"type": "array", "uniqueItems": true, "x-sort-key": ["type", "evidence_id"], "items": {"oneOf": [
        {"$ref": "#/evidence_type_registry/types/artifact_digest"},
        {"$ref": "#/evidence_type_registry/types/test_receipt"},
        {"$ref": "#/evidence_type_registry/types/process_identity"},
        {"$ref": "#/evidence_type_registry/types/control_observation"},
        {"$ref": "#/evidence_type_registry/types/authorization"},
        {"$ref": "#/evidence_type_registry/types/transaction_receipt"}
      ]}},
      "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "x-computed-by": "#/receipt_hash_contract"},
      "actor": {"type": "string", "x-equals-input": "actor"},
      "observed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
    },
    "allOf": [
      {"if": {"properties": {"verdict": {"const": "PASS"}}}, "then": {"properties": {"reason_codes": {"maxItems": 0}, "findings": {"maxItems": 0}}}},
      {"if": {"properties": {"verdict": {"const": "BLOCK"}}}, "then": {"properties": {"reason_codes": {"minItems": 1}, "findings": {"minItems": 1}}}}
    ]
  },
