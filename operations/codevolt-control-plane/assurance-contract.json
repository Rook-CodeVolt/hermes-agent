  "execution_evidence": {
    "kanban_worker_requires": [
      "current_task_run_binding",
      "pid_identity",
      "task_claim_lease",
      "fresh_heartbeat"
    ],
    "freshness_seconds": 90,
    "finalisation_revokes_before_terminal_visibility": true,
    "standalone": {
      "counts_as_accountable_specialist": false,
      "required_fields": [
        "execution_pseudonym",
        "pid_identity",
        "target_pseudonyms",
        "expires_at",
        "heartbeat_at",
        "progress_seq"
      ],
      "states": ["warming", "executing", "stalled", "stale", "finalised"],
      "warming_rule": "first complete fresh observation",
      "executing_rule": "next fresh observation has strictly greater progress_seq",
      "stalled_rule": "fresh PID and lease without progress advance",
      "stale_rule": "expired lease, stale heartbeat, dead PID, or PID identity mismatch",
      "durable_runner_required": true,
      "open_shell_or_session_record_is_insufficient": true
    }
  },
  "continuity": {
    "classes": [
      "executing_specialist",
      "ready",
      "dependency_gated",
      "protected_stop",
      "malformed",
      "historical"
    ],
    "classes_are_disjoint": true,
    "totals_must_reconcile": true,
    "verdict_precedes_status": true,
    "blocking_verdicts": ["BLOCK", "REJECT", "PIVOT_REQUIRED"],
    "review_requires_current_reviewer_process": true,
    "runway": {
      "target_min": 2,
      "target_max": 3,
      "metric": "unique_accountable_specialists",
      "worker_process_count_reported_separately": true,
      "one_lane_exception": "all other records reconciled as dependency_gated, protected_stop, malformed, or colliding"
    },
    "critical_path": {
      "declaration": "explicit machine field",
      "title_inference_forbidden": true,
      "allowed_successor_statuses": ["todo", "ready", "running", "review"],
      "prohibited_successor_statuses": ["blocked", "done", "archived"],
      "missing_or_malformed_child_satisfies": false
    },
    "guard_authority": {
      "may": [
        "observe",
        "classify",
        "dispatch_at_most_one_already_ready_exact_task",
        "alert_rook"
      ],
      "may_not": [
        "create_tasks",
        "repair_dependencies",
        "invent_owners",
        "override_verdicts",
        "normalize_boards",
        "wake_reasoning_governor",
        "run_second_manager"
      ]
    }
  },
  "scheduling": {
    "website_lane_minimum_while_unresolved_and_safe_work_exists": 1,
    "preventive_implementation_prerequisites": [
      "website_live_gate_literal_PASS",
      "website_exact_live_readback",
      "website_public_checks_PASS",
      "website_rollback_evidence_present",
      "continuity_exact_byte_review_literal_PASS",
      "continuity_active_runtime_review_literal_PASS"
    ],
    "critical_authority_or_safety_incident_can_pause_other_work": true,
    "exception_recorder": "Rook",
    "commercial_urgency_can_weaken_controls": false
  },
  "slos": [
    {
      "id": "SLO-AUTH",
      "indicator": "protected mutations with exact current authority binding",
      "objective": "100%",
      "error_budget": "0 events",
      "breach_action": "block activation and alert Rook"
    },
    {
      "id": "SLO-RELEASE",
      "indicator": "installed files matching one approved manifest at every declared destination",
      "objective": "100%",
      "error_budget": "0 files",
      "breach_action": "restore transaction preimages and block"
    },
    {
      "id": "SLO-ORDER",
      "indicator": "activations preceded by independent exact-byte PASS",
      "objective": "100%",
      "error_budget": "0 activations",
      "breach_action": "contain, reject activation process, require new release"
    },
    {
      "id": "SLO-WATCHDOG",
      "indicator": "scheduled observations persisted with reconciled result within 10 seconds",
      "objective": ">=99.9% monthly",
      "error_budget": "0.1% count-based monthly",
      "breach_action": "critical alert after two misses or 120-second evidence gap"
    },
    {
      "id": "SLO-DETECTION",
      "indicator": "critical control-plane faults detected and alertable",
      "objective": "<=120 seconds",
      "error_budget": "0 intervals beyond 120 seconds",
      "breach_action": "block discretionary control-plane releases"
    },
    {
      "id": "SLO-FRESHNESS",
      "indicator": "records presented as executing with complete mutually consistent evidence <=90 seconds old",
      "objective": ">=99% monthly",
      "error_budget": "1% count-based monthly; stale records are excluded immediately",
      "breach_action": "classify malformed and create bounded correction"
    },
    {
      "id": "SLO-RECOVERY",
      "indicator": "failed activations restored to exact preimages and declared prior service state",
      "objective": "<=300 seconds",
      "error_budget": "0 unreconciled partial activations",
      "breach_action": "critical incident"
    },
    {
      "id": "SLO-ALERT",
      "indicator": "external alerts conform to allowlist",
      "objective": "100%",
      "error_budget": "0 disclosures",
      "breach_action": "disable external projection and alert Rook locally"
    }
